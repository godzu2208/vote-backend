# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS - domain của frontend (Vercel), không dùng dấu / cuối
FRONTEND_ORIGIN=https://vote-frontend.vercel.app

# Danh sách email admin, phân cách bởi dấu phẩy, không khoảng trắng
ADMIN_EMAILS=admin1@rever.vn,admin2@rever.vn

# Domain bắt buộc cho user thường
ALLOWED_EMAIL_DOMAIN=rever.vn

# Port server
PORT=4000

# Chu kỳ cron kiểm tra hết giờ (ms)
SESSION_CLOSE_CHECK_INTERVAL_MS=2000
